{
  "version": 1,
  "name": "ใบกำกับภาษี / ใบเสร็จรับเงิน",
  "page": {
    "preset": "A4",
    "orientation": "portrait",
    "margin": { "top": 12, "right": 12, "bottom": 12, "left": 12 }
  },
  "defaultStyle": { "fontFamily": "Sarabun", "fontSize": 10, "color": "#111827", "lineHeight": 1.35 },
  "styles": {
    "title": { "fontSize": 18, "fontWeight": 700, "color": "#0f172a" },
    "label": { "fontSize": 9, "color": "#6b7280" },
    "value": { "fontSize": 10, "fontWeight": 500 },
    "th": {
      "fontSize": 9.5,
      "fontWeight": 700,
      "color": "#ffffff",
      "background": "#1e3a5f",
      "padding": { "top": 1.6, "right": 2, "bottom": 1.6, "left": 2 }
    },
    "td": {
      "fontSize": 9.5,
      "padding": { "top": 1.4, "right": 2, "bottom": 1.4, "left": 2 },
      "border": { "bottom": { "width": 0.4, "color": "#e5e7eb" } }
    },
    "num": { "align": "right" },
    "totalLabel": { "fontSize": 10, "fontWeight": 600, "align": "right", "padding": { "top": 1.4, "right": 2, "bottom": 1.4, "left": 2 } },
    "totalValue": { "fontSize": 10, "fontWeight": 700, "align": "right", "padding": { "top": 1.4, "right": 2, "bottom": 1.4, "left": 2 } }
  },

  "header": {
    "height": 46,
    "items": [
      {
        "frame": { "x": 12, "y": 0, "w": 100 },
        "node": { "id": "seller-name", "type": "text", "style": { "fontSize": 14, "fontWeight": 700, "color": "#1e3a5f" }, "content": "{{ seller.name }}" }
      },
      {
        "frame": { "x": 12, "y": 7, "w": 100 },
        "node": {
          "id": "seller-addr",
          "type": "text",
          "styleRef": "label",
          "style": { "whiteSpace": "pre-wrap" },
          "content": "{{ seller.address }}\nเลขประจำตัวผู้เสียภาษี {{ seller.taxId }}\nโทร. {{ seller.phone }}"
        }
      },
      {
        "frame": { "x": 122, "y": 0, "w": 76 },
        "node": { "id": "doc-title", "type": "text", "styleRef": "title", "style": { "align": "right" }, "content": "{{ doc.title }}" }
      },
      {
        "frame": { "x": 122, "y": 9, "w": 76 },
        "node": { "id": "doc-kind", "type": "text", "styleRef": "label", "style": { "align": "right" }, "content": "{{ doc.copyLabel }}" }
      },
      {
        "frame": { "x": 122, "y": 15, "w": 76, "h": 18 },
        "node": {
          "id": "doc-meta",
          "type": "table",
          "columns": [{ "width": "1fr" }, { "width": "1.4fr" }],
          "cellStyle": { "fontSize": 9, "padding": { "top": 0.6, "right": 0, "bottom": 0.6, "left": 0 } },
          "head": [],
          "body": [
            {
              "id": "m1",
              "cells": [
                { "content": [{ "id": "m1l", "type": "text", "styleRef": "label", "content": "เลขที่" }] },
                { "content": [{ "id": "m1v", "type": "text", "styleRef": "value", "style": { "align": "right" }, "content": "{{ doc.number }}" }] }
              ]
            },
            {
              "id": "m2",
              "cells": [
                { "content": [{ "id": "m2l", "type": "text", "styleRef": "label", "content": "วันที่" }] },
                { "content": [{ "id": "m2v", "type": "text", "styleRef": "value", "style": { "align": "right" }, "content": "{{ doc.issuedAt | thaidate:'D MMMM YYYY' }}" }] }
              ]
            },
            {
              "id": "m3",
              "cells": [
                { "content": [{ "id": "m3l", "type": "text", "styleRef": "label", "content": "ครบกำหนด" }] },
                { "content": [{ "id": "m3v", "type": "text", "styleRef": "value", "style": { "align": "right" }, "content": "{{ doc.dueAt | thaidate:'D MMM YY' }}" }] }
              ]
            }
          ],
          "foot": []
        }
      },
      {
        "frame": { "x": 12, "y": 27, "w": 186, "h": 17 },
        "node": {
          "id": "buyer-box",
          "type": "stack",
          "direction": "column",
          "gap": 0.8,
          "style": {
            "background": "#f8fafc",
            "border": { "all": { "width": 0.4, "color": "#cbd5e1" } },
            "radius": 1,
            "padding": { "top": 2, "right": 3, "bottom": 2, "left": 3 }
          },
          "children": [
            { "id": "buyer-l", "type": "text", "styleRef": "label", "content": "ลูกค้า / CUSTOMER" },
            { "id": "buyer-n", "type": "text", "style": { "fontSize": 11, "fontWeight": 600 }, "content": "{{ buyer.name }}" },
            { "id": "buyer-a", "type": "text", "styleRef": "label", "content": "{{ buyer.address }}  •  เลขประจำตัวผู้เสียภาษี {{ buyer.taxId }}" }
          ]
        }
      },
      {
        "frame": { "x": 12, "y": 45, "w": 186 },
        "node": { "id": "hr", "type": "line", "style": { "border": { "all": { "width": 0.6, "color": "#1e3a5f" } } } }
      }
    ]
  },

  "footer": {
    "height": 24,
    "items": [
      {
        "frame": { "x": 12, "y": 2, "w": 186 },
        "node": { "id": "fhr", "type": "line", "style": { "border": { "all": { "width": 0.3, "color": "#cbd5e1" } } } }
      },
      {
        "frame": { "x": 12, "y": 5, "w": 110 },
        "node": { "id": "fnote", "styleRef": "label", "type": "text", "content": "{{ doc.note }}" }
      },
      {
        "frame": { "x": 128, "y": 5, "w": 70 },
        "node": { "id": "pageno", "type": "pageNumber", "styleRef": "label", "style": { "align": "right" }, "format": "หน้า {page} จาก {pages}" }
      },
      {
        "frame": { "x": 128, "y": 12, "w": 70 },
        "on": "last",
        "node": { "id": "sign", "type": "text", "styleRef": "label", "style": { "align": "right", "border": { "top": { "width": 0.3, "color": "#94a3b8" } }, "padding": { "top": 1 } }, "content": "ผู้มีอำนาจลงนาม" }
      }
    ]
  },

  "overlay": [
    {
      "frame": { "x": 60, "y": 120, "w": 100, "rotate": -30 },
      "on": "all",
      "node": {
        "id": "stamp",
        "type": "text",
        "visibleIf": "doc.cancelled",
        "style": { "fontSize": 48, "fontWeight": 700, "color": "#dc2626", "opacity": 0.18, "align": "center" },
        "content": "ยกเลิก"
      }
    }
  ],

  "body": [
    {
      "id": "items",
      "type": "table",
      "columns": [{ "width": 12 }, { "width": "1fr" }, { "width": 20 }, { "width": 32 }, { "width": 30 }],
      "cellStyle": { "fontSize": 9.5 },
      "zebraStyle": { "background": "#f9fafb" },
      "head": [
        {
          "id": "h",
          "cells": [
            { "styleRef": "th", "content": [{ "id": "h1", "type": "text", "style": { "align": "center" }, "content": "#" }] },
            { "styleRef": "th", "content": [{ "id": "h2", "type": "text", "content": "รายการ" }] },
            { "styleRef": "th", "content": [{ "id": "h3", "type": "text", "style": { "align": "right" }, "content": "จำนวน" }] },
            { "styleRef": "th", "content": [{ "id": "h4", "type": "text", "style": { "align": "right" }, "content": "ราคา/หน่วย" }] },
            { "styleRef": "th", "content": [{ "id": "h5", "type": "text", "style": { "align": "right" }, "content": "จำนวนเงิน" }] }
          ]
        }
      ],
      "body": [
        {
          "id": "r",
          "each": { "in": "items", "as": "it", "indexAs": "i" },
          "cells": [
            { "styleRef": "td", "content": [{ "id": "c1", "type": "text", "style": { "align": "center", "color": "#6b7280" }, "content": "{{ i + 1 }}" }] },
            {
              "styleRef": "td",
              "content": [
                { "id": "c2a", "type": "text", "style": { "fontWeight": 500 }, "content": "{{ it.name }}" },
                { "id": "c2b", "type": "text", "visibleIf": "it.description", "style": { "fontSize": 8.5, "color": "#6b7280" }, "content": "{{ it.description }}" }
              ]
            },
            { "styleRef": "td", "content": [{ "id": "c3", "type": "text", "style": { "align": "right" }, "content": "{{ it.qty | number:0 }} {{ it.unit }}" }] },
            { "styleRef": "td", "content": [{ "id": "c4", "type": "text", "style": { "align": "right" }, "content": "{{ it.price | number:2 }}" }] },
            { "styleRef": "td", "content": [{ "id": "c5", "type": "text", "style": { "align": "right", "fontWeight": 500 }, "content": "{{ it.qty * it.price | number:2 }}" }] }
          ]
        }
      ],
      "foot": [
        {
          "id": "f1",
          "cells": [
            { "colSpan": 3, "rowSpan": 4, "style": { "valign": "top", "padding": { "top": 3, "right": 3 } }, "content": [
              { "id": "words-l", "type": "text", "styleRef": "label", "content": "จำนวนเงินรวมทั้งสิ้น (ตัวอักษร)" },
              { "id": "words-v", "type": "text", "style": { "fontWeight": 600, "fontSize": 10 }, "content": "( {{ totals.grand | bahttext }} )" }
            ] },
            { "styleRef": "totalLabel", "content": [{ "id": "t1l", "type": "text", "content": "รวมเป็นเงิน" }] },
            { "styleRef": "totalValue", "content": [{ "id": "t1v", "type": "text", "content": "{{ totals.subtotal | number:2 }}" }] }
          ]
        },
        {
          "id": "f2",
          "cells": [
            { "styleRef": "totalLabel", "content": [{ "id": "t2l", "type": "text", "content": "ส่วนลด" }] },
            { "styleRef": "totalValue", "content": [{ "id": "t2v", "type": "text", "content": "{{ totals.discount | number:2 }}" }] }
          ]
        },
        {
          "id": "f3",
          "cells": [
            { "styleRef": "totalLabel", "content": [{ "id": "t3l", "type": "text", "content": "ภาษีมูลค่าเพิ่ม {{ totals.vatRate }}%" }] },
            { "styleRef": "totalValue", "content": [{ "id": "t3v", "type": "text", "content": "{{ totals.vat | number:2 }}" }] }
          ]
        },
        {
          "id": "f4",
          "cells": [
            { "styleRef": "totalLabel", "style": { "background": "#1e3a5f", "color": "#ffffff" }, "content": [{ "id": "t4l", "type": "text", "content": "จำนวนเงินรวมทั้งสิ้น" }] },
            { "styleRef": "totalValue", "style": { "background": "#1e3a5f", "color": "#ffffff", "fontSize": 11 }, "content": [{ "id": "t4v", "type": "text", "content": "{{ totals.grand | number:2 }}" }] }
          ]
        }
      ]
    }
  ]
}
